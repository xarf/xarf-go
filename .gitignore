# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage.txt

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
bin/

# Temporary files
tmp/
temp/

# Log files
*.log

# AI Tool Coordination (auto-generated, do not commit)
.claude-flow/
.swarm/
.aider/
.cursor/
.copilot/

# AI Tool Databases
*.db
!.claude/**/*.db

# Note: .claude/ directory IS tracked (for documentation)

